#cloud-config

manage_etc_hosts: true
locale: en_US.UTF-8

timezone: Europe/Berlin

ssh_pwauth: false
ssh_genkeytypes: [rsa, ecdsa, ed25519]

fqdn: {hostname}.virt.baltsch.com
hostname: myhost
prefer_fqdn_over_hostname: true
create_hostname_file: true

#requires packages for some OSs
keyboard:
  layout: de
  model: pc105
  variant: nodeadkeys
  options: compose:rwin

users:
  - name: wigster
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    plain_text_passwd: ThisPasswordWillNeverBeUsedSSHOnlyInstead
    shell: /usr/bin/bash
    ssh_authorized_keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPZgb/7zvi87gK/f32x1fL3U78F7C6assq6gT5jJw7X+ wigster-eddsa-key-internal-hosts"

write_files:
 - content: |
     \n (\S)
     eth0:\4{eth0}, \6{eth0}
   path: /etc/issue
   owner: root:root
   permissions: '0644'
 - content: |
     syntax on
     colorscheme evening
   path: /root/.vimrc
   owner: root:root
   permissions: '0644'

disable_root: true

package_update: true
package_upgrade: true

packages:
  - git
  - nano
  - vim
  - tmux
  - mc
  - dos2unix
  - bash-completion
{packagesPerOS}

final_message: |
  sensie cloud-init build complete
  Version: $version
  Timestamp: $timestamp
  Datasource: $datasource

cloud_config_modules:
  - runcmd
  - scripts-user
  - package_update_upgrade_install  
  - timezone
  - keyboard
  - update_hostname

cloud_final_modules:
  - final_message

runcmd:
  - [ cp, /root/.vimrc, /home/wigster/.vimrc ]
  - [ chown, wigster:wigster, /home/wigster/.vimrc ]
  - which apt && apt -y remove walinuxagent || echo "skipping deb-based task"
  - which apt && rm -rf /var/lib/waagent || echo "skipping deb-based task"
  - which apt && rm -f /var/log/waagent.log || echo "skipping deb-based task"
  - grep -qi "alma" /etc/os-release && dnf config-manager --set-enabled crb || echo "skipping rhel-based task"
  - grep -qi "alma" /etc/os-release && dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm || echo "skipping rhel-based task"
  - grep -qi "alma" /etc/os-release && dnf install -y htop || echo "skipping rhel-based task"
  - grep -qi "alma" /etc/os-release && dnf install -y ansible || echo "skipping rhel-based task"
  - grep -qi "alma" /etc/os-release && localectl set-keymap de || echo "skipping rhel-based task"
  - echo "ansible pull" > /dev/ttyS0
  - ansible-pull -i {hostname}, -d /opt/sensie_build -U https://github.com/jontywigster/sensie_build.git -e build={role} -e os={os} -e kvp_flag_enabled=false -e serial_port_enabled=true

